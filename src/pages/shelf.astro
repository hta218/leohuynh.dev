---
import HugeIcon from '~/components/icons/HugeIcon.astro'
import PageHeader from '~/components/PageHeader.astro'
import StudioShell from '~/components/studio/StudioShell.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getBooks, getMovies } from '~/lib/media'
import { SITE } from '~/lib/site'

// Items beyond these are rendered `hidden` and revealed by "Show more".
const BOOKS_PAGE = 12
const MOVIES_PAGE = 18

const books = (await getBooks()).sort((a, b) => b.userRating - a.userRating)
const reading = books.filter((b) => b.userShelves.includes('currently-reading'))
const readBooks = books.filter(
  (b) => !b.userShelves.includes('currently-reading'),
)

const movies = (await getMovies()).sort((a, b) => {
  if (b.yourRating === a.yourRating) return b.imdbRating - a.imdbRating
  return b.yourRating - a.yourRating
})
// Movies are already sorted by rating, so each group is a contiguous slice;
// `start` is its offset in the overall list, used for the initial `hidden`.
let start = 0
const groups = [...new Set(movies.map((m) => m.yourRating))].map((rating) => {
  const items = movies.filter((m) => m.yourRating === rating)
  const group = { rating, items, start }
  start += items.length
  return group
})
---

<BaseLayout
  title="Shelf"
  description="What I read and watch — books from my Goodreads bookshelf and movies from my IMDb ratings."
>
  <StudioShell active="/shelf" crumb="~/leohuynh.dev/shelf/">
    <PageHeader
      title="Shelf"
      description="What I read and watch — books from my Goodreads bookshelf, movies and TV from my IMDb ratings."
    >
      <nav class="mt-4 flex gap-4 font-mono text-xs">
        <a href="#reading" class="text-code-blue no-underline">→ reading ({books.length})</a>
        <a href="#watching" class="text-code-blue no-underline">→ watching ({movies.length})</a>
      </nav>
    </PageHeader>

    <section id="reading" class="mb-14 scroll-mt-24">
      <div class="mb-5 flex items-end justify-between gap-3 border-b border-line pb-2">
        <h2 class="m-0 text-[22px] tracking-[-0.04em]">Reading</h2>
        <a
          href={SITE.goodreadsBookshelfUrl}
          target="_blank"
          rel="noreferrer"
          class="font-mono text-xs text-code-blue no-underline">Goodreads ↗</a
        >
      </div>

      {
        books.length === 0 && (
          <p class="rounded-xl border border-line bg-white p-6 font-mono text-sm text-muted">
            Bookshelf snapshot unavailable right now.
          </p>
        )
      }

      {
        reading.length > 0 && (
          <div class="mb-10">
            <h3 class="mb-4 font-mono text-xs tracking-wide text-muted uppercase">
              Currently reading
            </h3>
            <div class="shelf-grid shelf-grid-lg">
              {reading.map((book) => (
                <a href={book.link} target="_blank" rel="noreferrer" class="shelf-item">
                  <span class="shelf-cover shelf-cover-book">
                    <img src={book.imageUrl} alt="" loading="lazy" />
                    <b class="shelf-badge">reading</b>
                  </span>
                  <span class="shelf-title">{book.title}</span>
                  <span class="shelf-meta">{book.authorName}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {
        readBooks.length > 0 && (
          <div data-shelf data-page={BOOKS_PAGE}>
            <h3 class="mb-4 font-mono text-xs tracking-wide text-muted uppercase">
              Read
            </h3>
            <div class="shelf-grid">
              {readBooks.map((book, i) => (
                <a
                  href={book.link}
                  target="_blank"
                  rel="noreferrer"
                  class="shelf-item"
                  data-shelf-item
                  hidden={i >= BOOKS_PAGE}
                >
                  <span class="shelf-cover shelf-cover-book">
                    <img src={book.imageUrl} alt="" loading="lazy" />
                  </span>
                  <span class="shelf-title">{book.title}</span>
                  <span class="shelf-meta">{book.authorName}</span>
                </a>
              ))}
            </div>
            {readBooks.length > BOOKS_PAGE && (
              <button type="button" class="shelf-more" data-shelf-more>
                Show more ({readBooks.length - BOOKS_PAGE})
              </button>
            )}
          </div>
        )
      }
    </section>

    <section id="watching" class="scroll-mt-24">
      <div class="mb-5 flex items-end justify-between gap-3 border-b border-line pb-2">
        <h2 class="m-0 text-[22px] tracking-[-0.04em]">Watching</h2>
        <a
          href={SITE.imdbRatingsList}
          target="_blank"
          rel="noreferrer"
          class="font-mono text-xs text-code-blue no-underline">IMDb ↗</a
        >
      </div>

      {
        movies.length === 0 ? (
          <p class="rounded-xl border border-line bg-white p-6 font-mono text-sm text-muted">
            Movies snapshot unavailable right now.
          </p>
        ) : (
          <div data-shelf data-page={MOVIES_PAGE}>
            <div class="mb-5 flex flex-wrap gap-1.5" role="group" aria-label="Filter by my rating">
              <button type="button" class="shelf-chip" data-shelf-filter="all" aria-pressed="true">
                All <span>{movies.length}</span>
              </button>
              {groups.map(({ rating, items }) => (
                <button
                  type="button"
                  class="shelf-chip"
                  data-shelf-filter={String(rating)}
                  aria-pressed="false"
                >
                  <HugeIcon name="star" size={12} class="shelf-star" />
                  {rating} <span>{items.length}</span>
                </button>
              ))}
            </div>
            <div class="shelf-grid">
              {groups.map(({ rating, items, start }) => (
                <>
                  <div
                    class="shelf-divider"
                    data-shelf-divider
                    data-rating={rating}
                    hidden={start >= MOVIES_PAGE}
                  >
                    <HugeIcon name="star" size={14} class="shelf-star" />
                    <strong>{rating}/10</strong>
                    <span class="shelf-divider-line" />
                    <span>{items.length} titles</span>
                  </div>
                  {items.map((m, i) => (
                    <a
                      href={m.url}
                      target="_blank"
                      rel="noreferrer"
                      class="shelf-item"
                      data-shelf-item
                      data-rating={m.yourRating}
                      hidden={start + i >= MOVIES_PAGE}
                    >
                      <span class="shelf-cover">
                        {m.poster && <img src={m.poster} alt="" loading="lazy" />}
                        {m.imdbRating > 0 && (
                          <b class="shelf-badge shelf-badge-imdb">IMDb {m.imdbRating}</b>
                        )}
                      </span>
                      <span class="shelf-title">{m.title}</span>
                      <span class="shelf-meta">
                        {m.year}
                        {m.titleType !== 'Movie' && ' · TV'}
                      </span>
                    </a>
                  ))}
                </>
              ))}
            </div>
            {movies.length > MOVIES_PAGE && (
              <button type="button" class="shelf-more" data-shelf-more>
                Show more ({movies.length - MOVIES_PAGE})
              </button>
            )}
          </div>
        )
      }
    </section>
  </StudioShell>
</BaseLayout>

<style is:global>
  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 0.875rem;
  }
  @media (min-width: 640px) {
    .shelf-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .shelf-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .shelf-grid-lg {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .shelf-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  .shelf-item[hidden] {
    display: none;
  }
  .shelf-cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-panel2);
  }
  /* Spine on the left, so only the right corners are rounded. */
  .shelf-cover-book {
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .shelf-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shelf-badge {
    position: absolute;
    top: 0.375rem;
    left: 0.375rem;
    border-radius: 0.25rem;
    background: var(--color-ink);
    padding: 0.0625rem 0.3125rem;
    font: 600 10px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #fff;
  }
  .shelf-badge-imdb {
    background: #f5c518;
    color: #000;
  }
  .shelf-title {
    margin-top: 0.5rem;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .shelf-item:hover .shelf-title {
    color: var(--color-code-blue);
    text-decoration: underline;
  }
  .shelf-meta {
    margin-top: 0.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 11px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-muted);
  }
  .shelf-star {
    flex: none;
    color: #f5b301;
  }
  .shelf-star path {
    fill: currentColor;
  }
  .shelf-divider {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-muted);
  }
  .shelf-divider:not(:first-child) {
    margin-top: 0.75rem;
  }
  .shelf-divider[hidden] {
    display: none;
  }
  .shelf-divider strong {
    font-size: 14px;
    color: var(--color-ink);
  }
  .shelf-divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }
  .shelf-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel);
    padding: 0.25rem 0.75rem;
    font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-ink);
  }
  .shelf-chip span {
    color: var(--color-muted);
  }
  .shelf-chip:hover {
    border-color: var(--color-ink);
  }
  .shelf-chip[aria-pressed='true'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }
  .shelf-chip[aria-pressed='true'] span {
    color: rgb(255 255 255 / 0.65);
  }
  .shelf-more {
    display: block;
    margin: 1.5rem auto 0;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-panel);
    padding: 0.5rem 1rem;
    font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-code-blue);
  }
  .shelf-more:hover {
    background: var(--color-panel2);
  }
  .shelf-more[hidden] {
    display: none;
  }
</style>

<script>
  // Filter + "Show more" over items already in the DOM: matching items up to
  // `limit` are shown, the rest stay hidden.
  function setupShelf(root: HTMLElement) {
    const page = Number(root.dataset.page)
    const items = [...root.querySelectorAll<HTMLElement>('[data-shelf-item]')]
    const dividers = [
      ...root.querySelectorAll<HTMLElement>('[data-shelf-divider]'),
    ]
    const more = root.querySelector<HTMLButtonElement>('[data-shelf-more]')
    const chips = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-shelf-filter]'),
    ]
    let rating = 'all'
    let limit = page

    function render() {
      const matches = items.filter(
        (item) => rating === 'all' || item.dataset.rating === rating,
      )
      for (const item of items) item.hidden = true
      for (const item of matches.slice(0, limit)) item.hidden = false
      // Rating dividers only make sense in the "all" view, and only once
      // their group has a visible item.
      for (const divider of dividers) {
        divider.hidden =
          rating !== 'all' ||
          !items.some(
            (item) =>
              !item.hidden && item.dataset.rating === divider.dataset.rating,
          )
      }
      const rest = matches.length - limit
      if (more) {
        more.hidden = rest <= 0
        more.textContent = `Show more (${rest})`
      }
      for (const chip of chips) {
        chip.setAttribute(
          'aria-pressed',
          String(chip.dataset.shelfFilter === rating),
        )
      }
    }

    more?.addEventListener('click', () => {
      limit += page
      render()
    })
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        rating = chip.dataset.shelfFilter ?? 'all'
        limit = page
        render()
      })
    }
  }

  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-shelf]')) {
      setupShelf(root)
    }
  })
</script>
